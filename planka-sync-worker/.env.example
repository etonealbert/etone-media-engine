# --- Planka ---
PLANKA_BASE_URL=http://localhost:3001
PLANKA_TOKEN=replace_me
PLANKA_AUTH_HEADER=Authorization
PLANKA_AUTH_PREFIX=Bearer

# Optional explicit project filter (comma-separated IDs)
PLANKA_PROJECT_IDS=

# Polling interval (seconds)
POLL_INTERVAL_SECONDS=20

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_CHAT_ID=replace_me

# --- Worker behavior ---
# When true, sends startup + heartbeat logs to Telegram
VERBOSE_NOTIFICATIONS=false
